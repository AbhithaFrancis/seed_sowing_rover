<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="seed_field">

    <include><uri>model://sun</uri></include>

    <gui>
      <camera name="user_camera">
        <pose>5 4.5 15 0 1.5707 1.5707</pose>
      </camera>
    </gui>

    <!-- Grass around the field -->
    <model name="grass">
      <static>true</static>
      <link name="link">
        <pose>5 4.5 0 0 0 0</pose>
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.2 0.5 0.2 1</ambient>
            <diffuse>0.2 0.5 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The field: soil, 3 soil zones, 5 crop rows, godown pad and shed (visual only) -->
    <model name="seed_field">
      <static>true</static>
      <link name="link">

        <visual name="soil_base">
          <pose>5 4.5 0.01 0 0 0</pose>
          <geometry><box><size>10 9 0.02</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>

        <!-- soil zones: dry (Seed A), moist (Seed B), wet (Seed C) -->
        <visual name="zone_dry">
          <pose>2 4.5 0.0225 0 0 0</pose>
          <geometry><box><size>4 9 0.005</size></box></geometry>
          <material><ambient>0.90 0.80 0.60 1</ambient><diffuse>0.90 0.80 0.60 1</diffuse></material>
        </visual>
        <visual name="zone_moist">
          <pose>5 4.5 0.0225 0 0 0</pose>
          <geometry><box><size>2 9 0.005</size></box></geometry>
          <material><ambient>0.75 0.58 0.38 1</ambient><diffuse>0.75 0.58 0.38 1</diffuse></material>
        </visual>
        <visual name="zone_wet">
          <pose>8 4.5 0.0225 0 0 0</pose>
          <geometry><box><size>4 9 0.005</size></box></geometry>
          <material><ambient>0.58 0.43 0.28 1</ambient><diffuse>0.58 0.43 0.28 1</diffuse></material>
        </visual>

        <!-- 5 crop rows -->
        <visual name="row_1">
          <pose>5 7.75 0.02 0 0 0</pose>
          <geometry><box><size>6 0.4 0.04</size></box></geometry>
          <material><ambient>0.22 0.14 0.07 1</ambient><diffuse>0.22 0.14 0.07 1</diffuse></material>
        </visual>
        <visual name="row_2">
          <pose>5 6.25 0.02 0 0 0</pose>
          <geometry><box><size>6 0.4 0.04</size></box></geometry>
          <material><ambient>0.22 0.14 0.07 1</ambient><diffuse>0.22 0.14 0.07 1</diffuse></material>
        </visual>
        <visual name="row_3">
          <pose>5 4.75 0.02 0 0 0</pose>
          <geometry><box><size>6 0.4 0.04</size></box></geometry>
          <material><ambient>0.22 0.14 0.07 1</ambient><diffuse>0.22 0.14 0.07 1</diffuse></material>
        </visual>
        <visual name="row_4">
          <pose>5 3.25 0.02 0 0 0</pose>
          <geometry><box><size>6 0.4 0.04</size></box></geometry>
          <material><ambient>0.22 0.14 0.07 1</ambient><diffuse>0.22 0.14 0.07 1</diffuse></material>
        </visual>
        <visual name="row_5">
          <pose>5 1.75 0.02 0 0 0</pose>
          <geometry><box><size>6 0.4 0.04</size></box></geometry>
          <material><ambient>0.22 0.14 0.07 1</ambient><diffuse>0.22 0.14 0.07 1</diffuse></material>
        </visual>

        <!-- godown -->
        <visual name="godown_pad">
          <pose>2.25 0.25 0.02 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.02</size></box></geometry>
          <material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
        <visual name="godown_shed">
          <pose>0.9 0.45 0.25 0 0 0</pose>
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.6 0.2 0.2 1</ambient><diffuse>0.6 0.2 0.2 1</diffuse></material>
        </visual>

      </link>
    </model>

  </world>
</sdf>
